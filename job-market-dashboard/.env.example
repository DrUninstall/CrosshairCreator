# Job Market Skills Intelligence Dashboard
# Environment Configuration
#
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# DATABASE
# =============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobmarket
DB_PORT=5432

# =============================================================================
# REDIS
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# APPLICATION PORTS
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# =============================================================================
# API KEYS (Required for scraping)
# =============================================================================

# SerpAPI - RECOMMENDED (Most reliable, legal)
# Free tier: 100 searches/month
# Get your key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ScraperAPI - Alternative proxy service (optional)
# Get your key at: https://www.scraperapi.com/
SCRAPERAPI_KEY=

# Bright Data - For advanced LinkedIn scraping (optional)
# Get credentials at: https://brightdata.com/
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# =============================================================================
# ADMIN
# =============================================================================
# Secret key for admin API access
# IMPORTANT: Change this to a strong random string!
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=change-this-in-production-use-strong-random-key

# =============================================================================
# OPTIONAL
# =============================================================================
DEBUG=false
