# Job Market Skills Intelligence Dashboard - Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Job Market Skills Intelligence"
APP_VERSION="1.0.0"
DEBUG=false

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobmarket
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/jobmarket

# =============================================================================
# REDIS (for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# =============================================================================
# SCRAPING API KEYS
# =============================================================================
# SerpAPI - RECOMMENDED (Most reliable, legal)
# Get your key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ScraperAPI - Alternative proxy service
# Get your key at: https://www.scraperapi.com/
SCRAPERAPI_KEY=

# Bright Data - For LinkedIn scraping (optional)
# Get credentials at: https://brightdata.com/
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# Oxylabs - Alternative proxy (optional)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# =============================================================================
# PROXY CONFIGURATION (for direct scraping)
# =============================================================================
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# =============================================================================
# RATE LIMITING (requests per minute per domain)
# =============================================================================
# LEGAL NOTE: These limits are set conservatively to respect server resources
RATE_LIMIT_LINKEDIN=10
RATE_LIMIT_INDEED=15
RATE_LIMIT_GLASSDOOR=10
RATE_LIMIT_DEFAULT=20

# Delay between requests (seconds)
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# =============================================================================
# CORS (allowed frontend origins)
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =============================================================================
# ADMIN
# =============================================================================
# Secret key for admin API endpoints
# IMPORTANT: Change this in production!
ADMIN_SECRET_KEY=change-this-in-production-use-strong-random-key
